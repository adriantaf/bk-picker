{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BK Picker",
  "version": "1.1.0",
  "identifier": "com.bkpicker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BK Picker",
        "width": 400,
        "height": 620,
        "minWidth": 360,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "alwaysOnTop": false,
        "visible": true,
        "focus": true
      },
      {
        "label": "loupe",
        "title": "Loupe",
        "width": 170,
        "height": 230,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Adrian Tafoya",
    "category": "Utility",
    "shortDescription": "Screen and image color picker with design-system matches.",
    "longDescription": "BK Picker captures colors from your screen or images, copies HEX/RGB/HSL/OKLCH, keeps history and favorites, builds simple palettes, and matches Tailwind, Material/Android, CSS named, and Bootstrap tokens. Made by Adrian Tafoya.",
    "copyright": "Copyright © Adrian Tafoya",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {}
}
